# BetterCord — Environment Variables
#
# Web app (Docker runtime, injected into config.json via docker-entrypoint.sh):
#
#   BETTERCORD_HOMESERVER   Matrix homeserver hostname (without https://)
#                           Default if unset: matrix.org
#                           Example: matrix.example.com
#
#   BETTERCORD_LIVEKIT_URL  LiveKit JWT service base URL (with https://)
#                           Required for voice/video calls in voice channels.
#                           Leave empty to disable voice, or set it to your
#                           livekit-jwt-service instance.
#                           Example: https://livekit-jwt.example.com
#
# Desktop Electron app (build-time, passed before `npm run build:desktop`):
#
#   BETTERCORD_APP_URL      The web app URL the Electron binary loads.
#                           Default if unset: https://chat.nilo.live
#                           Example: https://chat.example.com
#
#   BETTERCORD_CANARY_URL   Canary channel URL (falls back to BETTERCORD_APP_URL).
#                           Example: https://canary.example.com
#
# Usage with Docker:
#   docker run -e BETTERCORD_HOMESERVER=matrix.example.com \
#              -e BETTERCORD_LIVEKIT_URL=https://livekit-jwt.example.com \
#              -p 80:80 bettercord
#
# Or with a volume-mounted config.json (overrides ENV vars completely):
#   docker run -v /path/to/your/config.json:/app/config.json \
#              -p 80:80 bettercord

BETTERCORD_HOMESERVER=
BETTERCORD_LIVEKIT_URL=
BETTERCORD_APP_URL=
BETTERCORD_CANARY_URL=

# GitHub repo for desktop auto-updater and electron-builder publish target:
GITHUB_OWNER=
GITHUB_REPO=
