# BetterCord — Environment Variables
#
# ── Core (Docker runtime) ────────────────────────────────────────────────────
#
#   BETTERCORD_HOMESERVER      Matrix homeserver hostname (without https://)
#                              Default if unset: matrix.org
#                              Example: matrix.example.com
#
#   BETTERCORD_LIVEKIT_URL     LiveKit JWT service base URL (with https://)
#                              Required for voice/video calls.
#                              Example: https://livekit-jwt.example.com
#
#   BETTERCORD_PRESENCE_URL    Presence bridge base URL.
#                              Default: /api/presence (proxied through nginx).
#                              Example: https://presence.example.com/presence
#
#   BETTERCORD_VOICE_STATE_MODE  Controls how the frontend resolves participant presence.
#                              "livekit"  — prefer live LiveKit client state (default, safe for local dev).
#                              "bridge"   — bridge is authoritative source of truth (recommended for production).
#                              When set to "bridge", the frontend skips the LiveKit-client-state layer
#                              and reads all mute/camera/screenshare/deafen state from the bridge SSE stream.
#                              Example: bridge
#
#   BETTERCORD_AUTHORITATIVE_BRIDGE_MODE
#                              Explicit feature flag mirror for the frontend rollout.
#                              Usually you can just set BETTERCORD_VOICE_STATE_MODE=bridge.
#                              Example: true
#
#   BETTERCORD_DISABLE_MATRIX_PRESENCE_WRITES
#                              When true, the frontend stops writing io.bettercord.call.presence
#                              Matrix state events. Use this after the bridge + Redis + reconcile
#                              path is verified in production.
#                              Example: true
#
# ── Activities / Microapps (Docker runtime, optional) ───────────────────────
# These activate the Polls and Whiteboard apps in the 🚀 Activities catalog.
# Leave empty to hide them. Must be publicly reachable from users' browsers.
#
#   BETTERCORD_POLLS_URL       Public URL of your nordeck/matrix-poll-widget instance.
#                              Example: https://polls.example.com
#                              Start service: docker compose --profile microapps up -d polls-widget
#
#   BETTERCORD_WHITEBOARD_URL  Public URL of your nordeck/matrix-neoboard-widget instance.
#                              Example: https://whiteboard.example.com
#                              Start service: docker compose --profile microapps up -d neoboard-widget
#
#   POLLS_HOST_PORT            Host port for the polls-widget container (default: 3001)
#   WHITEBOARD_HOST_PORT       Host port for the neoboard-widget container (default: 3003)
#
# ── Presence bridge (docker-compose bridge service) ─────────────────────────
#
#   LIVEKIT_API_KEY            LiveKit API key for webhook validation in the bridge.
#   LIVEKIT_API_SECRET         LiveKit API secret for webhook validation.
#   LIVEKIT_URL                LiveKit server base URL for REST reconcile.
#                              Example: https://livekit.example.com
#
#   BRIDGE_VOICE_STATE_AUTHORITATIVE  Set to "true" to make the bridge the authoritative
#                              source of truth for voice state. Enables stricter consistency
#                              guarantees. Requires REDIS_URL when running multiple bridge
#                              instances or when state persistence across restarts is needed.
#                              Default: false (in-memory, safe for single-instance local dev).
#
#   REDIS_URL                  Redis connection URL for persistent voice state.
#                              Required when BRIDGE_VOICE_STATE_AUTHORITATIVE=true in production.
#                              Leave empty to use in-memory state only.
#                              Start Redis: docker compose --profile redis up -d redis
#                              Example: redis://redis:6379
#                              Example (with auth): redis://:password@redis:6379/0
#
# ── Desktop Electron app (build-time) ───────────────────────────────────────
#
#   BETTERCORD_APP_URL         The web app URL the Electron binary loads.
#                              Default: https://chat.nilo.live
#   BETTERCORD_CANARY_URL      Canary channel URL (falls back to BETTERCORD_APP_URL).
#
# ── Quick start with Docker Compose ─────────────────────────────────────────
#   cp .env.example .env
#   # Edit .env, then:
#   docker compose up -d
#
#   # To also start Polls + Whiteboard:
#   docker compose --profile microapps up -d
#
#   # To also start Redis (for persistent bridge voice state):
#   docker compose --profile redis up -d
#   # Then set REDIS_URL=redis://redis:6379 and BRIDGE_VOICE_STATE_AUTHORITATIVE=true below.

BETTERCORD_HOMESERVER=
BETTERCORD_LIVEKIT_URL=
BETTERCORD_PRESENCE_URL=
# Voice state resolution mode: "livekit" (default) or "bridge" (production recommended)
BETTERCORD_VOICE_STATE_MODE=livekit
BETTERCORD_AUTHORITATIVE_BRIDGE_MODE=false
BETTERCORD_DISABLE_MATRIX_PRESENCE_WRITES=false
BETTERCORD_POLLS_URL=
BETTERCORD_WHITEBOARD_URL=
POLLS_HOST_PORT=3001
WHITEBOARD_HOST_PORT=3003
BETTERCORD_APP_URL=
BETTERCORD_CANARY_URL=

# GitHub repo for desktop auto-updater and electron-builder publish target:
GITHUB_OWNER=
GITHUB_REPO=

# GIPHY API key for the GIF picker (https://developers.giphy.com/dashboard/)
VITE_GIPHY_API_KEY=

# ── Bridge: authoritative voice state service ────────────────────────────────
# Set BRIDGE_VOICE_STATE_AUTHORITATIVE=true and REDIS_URL for production deployments.
# Leave both empty for local dev (in-memory state, no Redis needed).
BRIDGE_VOICE_STATE_AUTHORITATIVE=false
LIVEKIT_URL=
REDIS_URL=
