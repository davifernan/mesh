# BetterCord — Environment Variables
#
# ── Core (Docker runtime) ────────────────────────────────────────────────────
#
#   BETTERCORD_HOMESERVER      Matrix homeserver hostname (without https://)
#                              Default if unset: matrix.org
#                              Example: matrix.example.com
#
#   BETTERCORD_LIVEKIT_URL     LiveKit JWT service base URL (with https://)
#                              Required for voice/video calls.
#                              Example: https://livekit-jwt.example.com
#
#   BETTERCORD_PRESENCE_URL    Presence bridge base URL.
#                              Default: /api/presence (proxied through nginx).
#                              Example: https://presence.example.com/presence
#
# ── Activities / Microapps (Docker runtime, optional) ───────────────────────
# These activate the Polls and Whiteboard apps in the 🚀 Activities catalog.
# Leave empty to hide them. Must be publicly reachable from users' browsers.
#
#   BETTERCORD_POLLS_URL       Public URL of your nordeck/matrix-poll-widget instance.
#                              Example: https://polls.example.com
#                              Start service: docker compose --profile microapps up -d polls-widget
#
#   BETTERCORD_WHITEBOARD_URL  Public URL of your nordeck/matrix-neoboard-widget instance.
#                              Example: https://whiteboard.example.com
#                              Start service: docker compose --profile microapps up -d neoboard-widget
#
#   POLLS_HOST_PORT            Host port for the polls-widget container (default: 3001)
#   WHITEBOARD_HOST_PORT       Host port for the neoboard-widget container (default: 3003)
#
# ── Presence bridge (docker-compose bridge service) ─────────────────────────
#
#   LIVEKIT_API_KEY            LiveKit API key for webhook validation in the bridge.
#   LIVEKIT_API_SECRET         LiveKit API secret for webhook validation.
#
# ── Desktop Electron app (build-time) ───────────────────────────────────────
#
#   BETTERCORD_APP_URL         The web app URL the Electron binary loads.
#                              Default: https://chat.nilo.live
#   BETTERCORD_CANARY_URL      Canary channel URL (falls back to BETTERCORD_APP_URL).
#
# ── Quick start with Docker Compose ─────────────────────────────────────────
#   cp .env.example .env
#   # Edit .env, then:
#   docker compose up -d
#
#   # To also start Polls + Whiteboard:
#   docker compose --profile microapps up -d

BETTERCORD_HOMESERVER=
BETTERCORD_LIVEKIT_URL=
BETTERCORD_PRESENCE_URL=
BETTERCORD_POLLS_URL=
BETTERCORD_WHITEBOARD_URL=
POLLS_HOST_PORT=3001
WHITEBOARD_HOST_PORT=3003
BETTERCORD_APP_URL=
BETTERCORD_CANARY_URL=

# GitHub repo for desktop auto-updater and electron-builder publish target:
GITHUB_OWNER=
GITHUB_REPO=

# GIPHY API key for the GIF picker (https://developers.giphy.com/dashboard/)
VITE_GIPHY_API_KEY=
