# mesh — Self-Hosting Configuration
# ═══════════════════════════════════════════════════════════════════════════════
#
# QUICKSTART — Option 1 (Interactive setup, recommended):
#   curl -fsSL https://raw.githubusercontent.com/davifernan/mesh/main/setup.sh | sh
#
# QUICKSTART — Option 2 (Manual):
#   1. cp .env.example .env
#   2. Fill in the values below (at minimum: MESH_HOMESERVER)
#   3. docker compose up -d
#
# LOCAL DEV (built-in LiveKit, no account needed):
#   1. cp .env.example .env
#   2. Set MESH_HOMESERVER (or leave as matrix.org)
#   3. docker compose --profile livekit up -d
#   Dev keys are pre-filled — LiveKit + Bridge connect automatically.
#
# Full documentation: DEPLOY.md
# ═══════════════════════════════════════════════════════════════════════════════


# ── MATRIX ───────────────────────────────────────────────────────────────────
# Your Matrix homeserver hostname (without https://).
# This is the only REQUIRED value. Everything else has sensible defaults.
MESH_HOMESERVER=matrix.org

# Allow users to log in with any homeserver, not just the one above.
# Set to false for locked-down deployments where only your server is allowed.
MESH_ALLOW_CUSTOM_HOMESERVERS=false


# ── LIVEKIT ──────────────────────────────────────────────────────────────────
# LiveKit JWT service URL — needed for voice/video calls.
# If using --profile livekit (built-in LiveKit), leave this empty.
# If using LiveKit Cloud: set to your LiveKit Cloud JWT service URL.
MESH_LIVEKIT_URL=

# LiveKit API credentials.
# Pre-filled with dev defaults that match contrib/livekit/livekit.yaml.
# CHANGE THESE FOR PRODUCTION — generate real keys with:
#   docker run --rm livekit/livekit-server generate-keys
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-changeme-32chars-min

# LiveKit server URL — used by the bridge for REST reconciliation.
# If using --profile livekit: leave empty (auto-discovered via Docker network).
# If using LiveKit Cloud: set to your LiveKit Cloud URL (e.g. wss://your-app.livekit.cloud).
LIVEKIT_URL=


# ── PRESENCE BRIDGE ─────────────────────────────────────────────────────────
# How the frontend resolves participant presence (mute/camera/screenshare).
#   "livekit" = use live LiveKit client state (default, good for dev)
#   "bridge"  = bridge is authoritative source of truth (recommended for production)
MESH_VOICE_STATE_MODE=livekit

# Explicit feature flag for authoritative bridge mode.
# Usually you just set MESH_VOICE_STATE_MODE=bridge instead.
MESH_AUTHORITATIVE_BRIDGE_MODE=false

# Presence bridge URL (as seen by the user's browser).
# Default: /api/presence (proxied through nginx inside the mesh container).
# Only change this if you expose the bridge on a separate domain.
MESH_PRESENCE_URL=

# Redis — voice state persistence across bridge restarts.
# Pre-filled to use the built-in Redis container. No action needed.
REDIS_URL=redis://redis:6379


# ── CLOUDFLARE TUNNEL (optional) ────────────────────────────────────────────
# Auto-HTTPS without opening ports. No nginx/certbot/Let's Encrypt needed.
# Get a token: dash.cloudflare.com → Zero Trust → Networks → Tunnels → Create
#
# IMPORTANT: This token is tied to YOUR domain in Cloudflare. Never share it.
# In your tunnel config, route your domain to http://mesh:80
#
# Start: docker compose --profile cloudflare up -d
CLOUDFLARE_TUNNEL_TOKEN=


# ── ACTIVITIES: POLLS & WHITEBOARD (optional) ───────────────────────────────
# Activate the Polls and Whiteboard apps in the Activities catalog.
# Must be publicly reachable URLs (loaded by users' browsers, not the server).
# Leave empty to hide them from the catalog.
#
# Start services: docker compose --profile microapps up -d
MESH_POLLS_URL=
MESH_WHITEBOARD_URL=

# Host ports for the widget containers (change if ports are already in use).
POLLS_HOST_PORT=3003
WHITEBOARD_HOST_PORT=3004


# ── ADVANCED ────────────────────────────────────────────────────────────────
# Port for the mesh frontend container on the host.
MESH_PORT=80

# LiveKit server port on the host (only used with --profile livekit).
LIVEKIT_PORT=7880


# ── DESKTOP APP (build-time only, not needed for self-hosting) ──────────────
MESH_APP_URL=
MESH_CANARY_URL=
GITHUB_OWNER=
GITHUB_REPO=

# GIPHY API key for the GIF picker (https://developers.giphy.com/dashboard/).
# Build-time only — baked into the frontend JS bundle during image build.
VITE_GIPHY_API_KEY=
