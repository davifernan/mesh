{
  "defaultHomeserver": 0,
  "homeserverList": [
    "${BETTERCORD_HOMESERVER}"
  ],
  "allowCustomHomeservers": false,

  "hashRouter": {
    "enabled": false,
    "basename": "/"
  },

  "livekitServiceUrl": "${BETTERCORD_LIVEKIT_URL}",
  "presenceUrl": "${BETTERCORD_PRESENCE_URL}",

  "voiceStateMode": "${BETTERCORD_VOICE_STATE_MODE}",
  "featureFlags": {
    "authoritativeBridgeMode": ${BETTERCORD_AUTHORITATIVE_BRIDGE_MODE},
    "disableMatrixPresenceWrites": ${BETTERCORD_DISABLE_MATRIX_PRESENCE_WRITES}
  }
}
