{
  "defaultHomeserver": 0,
  "homeserverList": [
    "${MESH_HOMESERVER}"
  ],
  "allowCustomHomeservers": ${MESH_ALLOW_CUSTOM_HOMESERVERS},

  "hashRouter": {
    "enabled": false,
    "basename": "/"
  },

  "livekitServiceUrl": "${MESH_LIVEKIT_URL}",
  "presenceUrl": "${MESH_PRESENCE_URL}",
  "presenceAuthSecret": "${BRIDGE_AUTH_SECRET}",

  "tokenStorageMode": "${MESH_TOKEN_STORAGE_MODE}",

  "defaultAudioBitrate": 128,

  "voiceStateMode": "${MESH_VOICE_STATE_MODE}",
  "featureFlags": {
    "authoritativeBridgeMode": ${MESH_AUTHORITATIVE_BRIDGE_MODE},
    "experimentalAV1": false
  }
}
