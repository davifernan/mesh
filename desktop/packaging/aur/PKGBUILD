# Maintainer: BetterCord Contributors <https://github.com/davifernan/BetterCord>
pkgname=bettercord-bin
pkgver=PLACEHOLDER_VERSION
pkgrel=1
pkgdesc='Instant messaging and VoIP application'
arch=('x86_64' 'aarch64')
url='https://github.com/davifernan/BetterCord'
license=('AGPL-3.0-or-later')
depends=('gtk3' 'libnotify' 'nss' 'libxss' 'libxtst' 'xdg-utils'
         'at-spi2-core' 'util-linux-libs' 'libsecret' 'libappindicator-gtk3')
optdepends=('libpipewire: screen sharing via PipeWire')
provides=('bettercord')
conflicts=('bettercord')
options=('!strip' '!debug')

_filename_x86_64="bettercord-stable-${pkgver}-x86_64.tar.gz"
_filename_aarch64="bettercord-stable-${pkgver}-aarch64.tar.gz"

source_x86_64=("${_filename_x86_64}::https://github.com/davifernan/BetterCord/releases/download/${pkgver}/bettercord-stable-${pkgver}-x86_64.tar.gz")
source_aarch64=("${_filename_aarch64}::https://github.com/davifernan/BetterCord/releases/download/${pkgver}/bettercord-stable-${pkgver}-aarch64.tar.gz")
sha256sums_x86_64=('PLACEHOLDER_SHA256_X64')
sha256sums_aarch64=('PLACEHOLDER_SHA256_ARM64')

package() {
    install -d "${pkgdir}/opt/bettercord"
    cp -r "${srcdir}/"* "${pkgdir}/opt/bettercord/"
    chmod +x "${pkgdir}/opt/bettercord/bettercord"

    install -d "${pkgdir}/usr/bin"
    ln -s /opt/bettercord/bettercord "${pkgdir}/usr/bin/bettercord"

    install -Dm644 /dev/stdin "${pkgdir}/usr/share/applications/bettercord.desktop" <<EOF
[Desktop Entry]
Name=BetterCord
Comment=Instant messaging and VoIP application
Exec=/opt/bettercord/bettercord %U
Icon=bettercord
Type=Application
Categories=Network;InstantMessaging;
StartupWMClass=bettercord
MimeType=x-scheme-handler/bettercord;
Terminal=false
EOF

    for size in 16 32 48 64 128 256 512; do
        if [ -f "${srcdir}/resources/icons/${size}x${size}.png" ]; then
            install -Dm644 "${srcdir}/resources/icons/${size}x${size}.png" \
                "${pkgdir}/usr/share/icons/hicolor/${size}x${size}/apps/bettercord.png"
        fi
    done
}
